---
/**
 * SiteSage — Humanoid Construction Worker SVG Component
 * Renders anatomically articulated construction worker figures with authentic PPE,
 * hard hats, high-vis vests, toolbelts, and dynamic jobsite postures.
 */

export interface Props {
  x?: number;
  y?: number;
  scale?: number;
  pose?: 'walking-tool' | 'standing-tablet' | 'rigging-signal' | 'kneeling';
  hasHelmet?: boolean;
  helmetColor?: string;
  vestColor?: 'lime' | 'orange';
  isAlert?: boolean;
  workerName?: string;
  workerTrade?: string;
  workerId?: string;
}

const {
  x = 0,
  y = 0,
  scale = 1,
  pose = 'walking-tool',
  hasHelmet = true,
  helmetColor = '#EAB308', // OSHA Yellow
  vestColor = 'orange',
  isAlert = false,
  workerName = 'Worker',
  workerTrade = 'Tradesperson',
  workerId = 'WORKER-01',
} = Astro.props;

const vestFill = vestColor === 'lime' ? '#84CC16' : '#EA580C';
const vestTape = '#E2E8F0'; // 3M Scotchlite reflective silver
const shirtColor = vestColor === 'lime' ? '#1E293B' : '#0F172A';
const pantsColor = '#1E3A5F'; // Heavy dark work denim
const bootsColor = '#78350F'; // Tan Red-Wing style leather work boots
---

<g
  class={`humanoid-worker ${isAlert ? 'worker-alert' : 'worker-ok'}`}
  transform={`translate(${x}, ${y}) scale(${scale})`}
  data-worker-id={workerId}
  data-worker-name={workerName}
  data-worker-trade={workerTrade}
  style="cursor:pointer;"
>
  {/* Subtle ground contact shadow */}
  <ellipse cx="20" cy="118" rx="18" ry="4" fill="rgba(0,0,0,0.4)" filter="blur(1px)"/>

  {pose === 'walking-tool' && (
    /* POSE: Walking carrying tool (Marcus Vance style) */
    <g>
      {/* Back leg & boot */}
      <path d="M14,64 L10,88 L6,114 L-2,116 L-2,118 L12,118 L16,90 L20,64 Z" fill="#152840"/>
      <path d="M-2,114 L12,114 L14,118 L-4,118 Z" fill={bootsColor}/>
      <path d="M-4,117 L14,117 L13,119 L-4,119 Z" fill="#090d16"/> {/* Sole */}

      {/* Front leg & boot */}
      <path d="M22,64 L26,86 L32,112 L24,115 L24,118 L38,118 L33,88 L28,64 Z" fill={pantsColor}/>
      {/* Knee patch */}
      <path d="M24,82 L30,82 L29,94 L23,94 Z" fill="rgba(0,0,0,0.2)"/>
      {/* Front boot */}
      <path d="M24,112 L36,112 L41,117 L22,117 Z" fill={bootsColor}/>
      <path d="M21,117 L42,117 L41,119 L21,119 Z" fill="#090d16"/>

      {/* Torso & Work Shirt */}
      <path d="M11,32 L29,32 L32,64 L8,64 Z" fill={shirtColor}/>

      {/* High-Vis Vest */}
      <path d="M10,32 L30,32 L33,63 L7,63 Z" fill={vestFill}/>
      {/* Vest front gap */}
      <line x1="20" y1="34" x2="20" y2="63" stroke="#000" stroke-width="1.2" opacity="0.4"/>
      {/* Reflective tape: vertical harness bands */}
      <rect x="13" y="32" width="2.5" height="31" fill={vestTape} opacity="0.95"/>
      <rect x="24.5" y="32" width="2.5" height="31" fill={vestTape} opacity="0.95"/>
      {/* Reflective tape: horizontal waist band */}
      <rect x="7.5" y="54" width="25" height="2.5" fill={vestTape} opacity="0.95"/>

      {/* Leather Utility Toolbelt */}
      <rect x="7" y="61" width="26" height="5" rx="1" fill="#451A03"/>
      <rect x="18" y="61.5" width="4" height="4" fill="#D97706"/> {/* Brass buckle */}
      <rect x="27" y="65" width="6" height="8" rx="1" fill="#78350F"/> {/* Hammer pouch */}
      <line x1="30" y1="73" x2="30" y2="82" stroke="#64748B" stroke-width="2.5"/> {/* Hammer handle */}
      <rect x="28" y="82" width="7" height="3" fill="#334155"/> {/* Hammer head */}

      {/* Left arm (swung forward holding steel spud wrench) */}
      <path d="M29,34 L38,48 L46,60 L43,63 L35,51 L27,38 Z" fill={shirtColor}/>
      {/* Hand & glove */}
      <circle cx="46" cy="62" r="3.5" fill="#D97706"/> {/* Leather work glove */}
      {/* Steel spud wrench tool */}
      <line x1="43" y1="56" x2="52" y2="76" stroke="#94A3B8" stroke-width="2.5" stroke-linecap="round"/>
      <polygon points="41,56 46,54 44,59" fill="#64748B"/>

      {/* Right arm (back) */}
      <path d="M12,35 L4,48 L1,58 L4,60 L7,50 L14,39 Z" fill="#0F172A"/>
      <circle cx="2" cy="59" r="3" fill="#B45309"/>

      {/* Neck */}
      <rect x="17" y="27" width="6" height="6" fill="#FBBF24" opacity="0.9"/>

      {/* HEAD */}
      {hasHelmet ? (
        <g>
          {/* Face / chin */}
          <ellipse cx="20" cy="24" rx="5.5" ry="6.5" fill="#FBBF24"/>
          {/* Safety glasses */}
          <rect x="19" y="21" width="7" height="2.5" rx="1" fill="#38BDF8" opacity="0.8"/>
          {/* ANSI Hard Hat */}
          <path d="M11,20 C11,10 29,10 29,20 Z" fill={helmetColor}/>
          {/* Helmet brim */}
          <path d="M9,20 L32,20 L31,22 L9,22 Z" fill={helmetColor}/>
          {/* Helmet ridge */}
          <path d="M17,11 C19,10 21,10 23,11 L22,19 L18,19 Z" fill="rgba(255,255,255,0.3)"/>
          {/* Chin strap */}
          <path d="M14,21 L18,28 L22,21" fill="none" stroke="#334155" stroke-width="0.8"/>
        </g>
      ) : (
        /* NO HARD HAT — Human hair & head contour (TRIGGERING VIOLATION) */
        <g>
          {/* Face profile */}
          <ellipse cx="20" cy="23" rx="5.5" ry="6.5" fill="#FBBF24"/>
          <path d="M24,22 L27,24 L24,25 Z" fill="#FBBF24"/> {/* Nose profile */}
          {/* Natural Human Hair texture */}
          <path d="M13,22 C12,15 15,11 20,11 C26,11 28,15 27,20 C25,19 22,19 20,17 C18,19 15,20 13,22 Z" fill="#1C1917"/>
          <path d="M13,22 L14,16 L17,14 L22,14 L27,17 L25,21" fill="none" stroke="#292524" stroke-width="1.2"/>
          {/* Danger alert halo over exposed head */}
          {isAlert && (
            <circle cx="20" cy="18" r="14" fill="none" stroke="#EF4444" stroke-width="1.5" stroke-dasharray="3,2">
              <animate attributeName="stroke-opacity" values="1;0.2;1" dur="1.4s" repeatCount="indefinite"/>
            </circle>
          )}
        </g>
      )}
    </g>
  )}

  {pose === 'standing-tablet' && (
    /* POSE: Standing inspecting with field tablet (Elena Chen style) */
    <g>
      {/* Legs & heavy boots */}
      <path d="M14,64 L12,88 L11,114 L3,115 L3,118 L18,118 L19,90 L20,64 Z" fill={pantsColor}/>
      <path d="M3,114 L17,114 L18,118 L2,118 Z" fill={bootsColor}/>
      <path d="M2,117 L18,117 L18,119 L2,119 Z" fill="#090d16"/>

      <path d="M21,64 L22,88 L24,114 L18,115 L18,118 L32,118 L30,90 L27,64 Z" fill={pantsColor}/>
      {/* Reflective calf bands */}
      <rect x="11" y="98" width="8" height="2" fill={vestTape}/>
      <rect x="22" y="98" width="8" height="2" fill={vestTape}/>
      <path d="M18,114 L32,114 L33,118 L17,118 Z" fill={bootsColor}/>
      <path d="M17,117 L33,117 L33,119 L17,119 Z" fill="#090d16"/>

      {/* Torso */}
      <path d="M11,32 L29,32 L31,64 L9,64 Z" fill={shirtColor}/>
      {/* Lime Vest */}
      <path d="M10,32 L30,32 L32,63 L8,63 Z" fill={vestFill}/>
      {/* Vest tape (Cross over chest + waist) */}
      <line x1="12" y1="34" x2="28" y2="54" stroke={vestTape} stroke-width="2"/>
      <line x1="28" y1="34" x2="12" y2="54" stroke={vestTape} stroke-width="2"/>
      <rect x="8.5" y="55" width="23" height="2.5" fill={vestTape}/>

      {/* Fall Arrest Harness Straps */}
      <path d="M15,32 L15,62 M25,32 L25,62" stroke="#F59E0B" stroke-width="1.2"/>
      <circle cx="20" cy="42" r="2.5" fill="none" stroke="#94A3B8" stroke-width="1.5"/> {/* D-Ring */}

      {/* Left arm bent holding tablet */}
      <path d="M29,35 L36,46 L30,56 L24,53 L29,45 L25,37 Z" fill={shirtColor}/>
      {/* Right arm supporting tablet */}
      <path d="M11,35 L5,46 L12,56 L16,53 L11,45 L15,37 Z" fill={shirtColor}/>
      
      {/* Rugged Field Tablet */}
      <rect x="12" y="47" width="18" height="12" rx="1.5" fill="#0F172A" stroke="#334155" stroke-width="0.8"/>
      <rect x="14" y="49" width="14" height="8" rx="0.5" fill="#06B6D4" opacity="0.8"/> {/* Screen glow */}
      {/* Gloved hands holding tablet */}
      <circle cx="12" cy="53" r="2.5" fill="#D97706"/>
      <circle cx="30" cy="53" r="2.5" fill="#D97706"/>

      {/* Safety tether lanyard from D-ring to anchor line */}
      <path d="M20,42 Q28,38 38,32 Q48,26 62,24" fill="none" stroke="#EAB308" stroke-width="1.5" stroke-dasharray="3,1"/>
      <polygon points="62,22 66,24 62,26" fill="#94A3B8"/> {/* Carabiner clip */}

      {/* Head with Yellow Helmet */}
      <rect x="17" y="27" width="6" height="5" fill="#FBBF24"/>
      <ellipse cx="20" cy="23" rx="5.5" ry="6.5" fill="#FBBF24"/>
      <rect x="18" y="21" width="7" height="2" rx="0.8" fill="#38BDF8" opacity="0.9"/> {/* Polycarb goggles */}
      {/* Hard Hat with Visor */}
      <path d="M12,19 C12,10 28,10 28,19 Z" fill={helmetColor}/>
      <path d="M10,19 L30,19 L29,21 L10,21 Z" fill={helmetColor}/>
      <circle cx="20" cy="15" r="1.5" fill="#FFFFFF"/> {/* Apex company decal */}
    </g>
  )}

  {pose === 'rigging-signal' && (
    /* POSE: Rigger signaling crane with gloved hands (Jorge Reyes style) */
    <g>
      {/* Legs & boots */}
      <path d="M14,64 L12,88 L10,114 L2,115 L2,118 L17,118 L18,90 L20,64 Z" fill={pantsColor}/>
      <path d="M2,114 L16,114 L17,118 L1,118 Z" fill={bootsColor}/>
      <path d="M21,64 L23,88 L26,114 L20,115 L20,118 L34,118 L31,90 L27,64 Z" fill={pantsColor}/>
      <path d="M20,114 L34,114 L34,118 L19,118 Z" fill={bootsColor}/>

      {/* Torso */}
      <path d="M11,32 L29,32 L31,64 L9,64 Z" fill={shirtColor}/>
      <path d="M10,32 L30,32 L32,63 L8,63 Z" fill={vestFill}/>
      <rect x="13" y="32" width="2.5" height="31" fill={vestTape}/>
      <rect x="24.5" y="32" width="2.5" height="31" fill={vestTape}/>
      <rect x="8" y="55" width="24" height="2.5" fill={vestTape}/>

      {/* Both arms raised in signaling gesture */}
      <path d="M30,36 L40,24 L44,12 L39,11 L35,22 L27,33 Z" fill={shirtColor}/>
      <circle cx="42" cy="10" r="3.5" fill="#EF4444"/> {/* High-vis orange rigger glove */}

      <path d="M10,36 L0,24 L-4,12 L1,11 L5,22 L13,33 Z" fill={shirtColor}/>
      <circle cx="-2" cy="10" r="3.5" fill="#EF4444"/>

      {/* Head with White Supervisor / Rigger Helmet */}
      <rect x="17" y="27" width="6" height="5" fill="#FBBF24"/>
      <ellipse cx="20" cy="23" rx="5.5" ry="6.5" fill="#FBBF24"/>
      <path d="M12,19 C12,10 28,10 28,19 Z" fill="#F8FAFC"/> {/* White helmet */}
      <path d="M10,19 L30,19 L29,21 L10,21 Z" fill="#F8FAFC"/>
      {/* Ear defenders / muffs */}
      <circle cx="14" cy="22" r="2.5" fill="#EF4444"/>
      <circle cx="26" cy="22" r="2.5" fill="#EF4444"/>
    </g>
  )}
</g>

<style>
.humanoid-worker {
  transition: transform 0.2s ease, filter 0.2s ease;
}
.humanoid-worker:hover {
  filter: drop-shadow(0 0 6px rgba(59, 130, 246, 0.6));
}
.worker-alert:hover {
  filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.8));
}
</style>
