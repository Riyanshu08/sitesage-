---
/**
 * SiteSage — Application Shell Layout
 * Implements: TopNav, SidebarNav, Breadcrumb, Site Selector,
 * Notification Dropdown, Incident Drawer, Demo Controls.
 */
import '../styles/global.css';

export interface Props {
  title?: string;
  breadcrumb?: string[] | string;
  activePage?: string;
  fullBleed?: boolean;
}

const {
  title = 'Dashboard',
  breadcrumb = ['Site Dashboard', 'Live Monitoring'],
  activePage = 'dashboard',
  fullBleed = false,
} = Astro.props;

const breadcrumbList: string[] = Array.isArray(breadcrumb)
  ? breadcrumb
  : typeof breadcrumb === 'string'
  ? (breadcrumb as string).split('>').map((s: string) => s.trim())
  : ['Site Dashboard'];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="SiteSage — AI-powered construction site safety and real-time computer vision command center." />
  <meta name="theme-color" content="#0B1220" />
  <title>{title} — SiteSage</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>

<div class="app-shell" id="app-shell">

  <!-- ════════════════════════════════════════════
       TOP HEADER
  ════════════════════════════════════════════ -->
  <header class="top-header" role="banner">

    <!-- Brand -->
    <a href="/" class="brand" aria-label="SiteSage home">
      <svg class="brand-logo" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Hexagonal frame -->
        <polygon points="16,2 28,9 28,23 16,30 4,23 4,9"
          fill="#111827" stroke="#2563EB" stroke-width="1.5"/>
        <!-- Inner aperture -->
        <polygon points="16,7 23,11 23,21 16,25 9,21 9,11"
          fill="none" stroke="rgba(59,130,246,0.3)" stroke-width="0.8"/>
        <!-- CV crosshair + lens -->
        <circle cx="16" cy="16" r="4" fill="none" stroke="#3B82F6" stroke-width="1.5"/>
        <circle cx="16" cy="16" r="1.5" fill="#EF4444"/>
        <!-- Aperture blades -->
        <line x1="16" y1="5"  x2="16" y2="10" stroke="#3B82F6" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
        <line x1="16" y1="22" x2="16" y2="27" stroke="#3B82F6" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
        <line x1="5"  y1="16" x2="10" y2="16" stroke="#3B82F6" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
        <line x1="22" y1="16" x2="27" y2="16" stroke="#3B82F6" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
        <!-- Diagonal blades -->
        <line x1="9"  y1="9"  x2="13" y2="13" stroke="#3B82F6" stroke-width="1" stroke-linecap="round" opacity="0.5"/>
        <line x1="19" y1="19" x2="23" y2="23" stroke="#3B82F6" stroke-width="1" stroke-linecap="round" opacity="0.5"/>
        <line x1="23" y1="9"  x2="19" y2="13" stroke="#3B82F6" stroke-width="1" stroke-linecap="round" opacity="0.5"/>
        <line x1="9"  y1="23" x2="13" y2="19" stroke="#3B82F6" stroke-width="1" stroke-linecap="round" opacity="0.5"/>
      </svg>
      <span class="brand-name">SiteSage</span>
    </a>

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Page location">
      {breadcrumbList.map((crumb, i) => (
        <>
          {i > 0 && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
          <span class={i === breadcrumbList.length - 1 ? 'breadcrumb-current' : ''}>{crumb}</span>
        </>
      ))}
    </nav>

    <!-- Right controls -->
    <div class="header-right">

      <!-- Demo badge -->
      <div class="demo-badge" title="Simulated data — not real surveillance footage">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true">
          <circle cx="4" cy="4" r="3"/>
        </svg>
        Demo Mode
      </div>

      <!-- System status -->
      <div class="system-status ok" role="status" aria-live="polite" id="system-status-chip">
        <span class="status-dot safe" aria-hidden="true"></span>
        All Systems
      </div>

      <!-- Global search -->
      <div class="global-search-wrap">
        <svg class="global-search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          id="global-search"
          class="global-search"
          type="search"
          placeholder="Search alerts, cameras, incidents..."
          aria-label="Search alerts, cameras, and incidents"
          autocomplete="off"
        />
      </div>

      <!-- Notifications -->
      <div style="position:relative;" id="notif-wrap">
        <button
          class="icon-btn"
          id="notif-btn"
          aria-label="Notifications"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <span class="notif-count" id="notif-count" aria-label="7 unread notifications">7</span>
        </button>

        <!-- Notification dropdown -->
        <div
          class="notif-dropdown"
          id="notif-dropdown"
          role="dialog"
          aria-label="Notifications"
          aria-modal="false"
        >
          <div class="panel-header">
            <span class="panel-title">Notifications</span>
            <span class="badge badge-critical" style="font-size:9px;">7 NEW</span>
            <button class="btn btn-ghost btn-sm" style="margin-left:auto;font-size:11px;">Mark all read</button>
          </div>
          <div style="max-height:320px;overflow-y:auto;padding:6px;">
            {[
              { sev:'critical', msg:'No Hard Hat — Sector B, CAM-04',   time:'Just now' },
              { sev:'critical', msg:'Zone Breach — Crane Area, CAM-03', time:'2m ago' },
              { sev:'high',     msg:'No Safety Vest — Level 08, CAM-01',time:'5m ago' },
              { sev:'high',     msg:'PPE Alert — Loading Bay, CAM-06',  time:'8m ago' },
              { sev:'safe',     msg:'Compliance Restored — CAM-02',     time:'12m ago' },
              { sev:'high',     msg:'Unknown Person — Gate C, CAM-05',  time:'18m ago' },
              { sev:'critical', msg:'No Helmet — Sector B, CAM-04',     time:'32m ago' },
            ].map(n => (
              <div class={`alert-item ${n.sev === 'critical' ? 'critical-item' : ''}`}
                   style="margin-bottom:4px;" role="listitem">
                <span class={`status-dot ${n.sev === 'safe' ? 'safe' : n.sev === 'critical' ? 'critical' : 'warning'}`}
                      style="margin-top:4px;" aria-hidden="true"></span>
                <div class="alert-item-body">
                  <div class="alert-item-title">{n.msg}</div>
                  <div class="alert-item-meta">{n.time}</div>
                </div>
              </div>
            ))}
          </div>
          <div style="padding:8px;border-top:1px solid var(--color-border);">
            <a href="/incidents" class="btn btn-ghost" style="width:100%;justify-content:center;font-size:12px;">
              View all incidents
            </a>
          </div>
        </div>
      </div>

      <!-- Site selector -->
      <button class="site-selector-btn" id="site-selector" aria-label="Site: North Tower" aria-haspopup="listbox">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span id="site-label">North Tower</span>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>

      <!-- User profile -->
      <div class="user-chip" role="button" tabindex="0" aria-label="User menu" aria-haspopup="true">
        <div class="user-avatar" aria-hidden="true">SC</div>
        <span class="user-name">S. Chen</span>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color:var(--color-text-tertiary);margin-left:2px;" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </div>

    </div>
  </header>

  <!-- ════════════════════════════════════════════
       SIDEBAR NAVIGATION
  ════════════════════════════════════════════ -->
  <nav class="sidebar" aria-label="Main navigation" id="sidebar">

    <span class="sidebar-section-label">Operations</span>

    <a href="/dashboard"
       class={`nav-link ${activePage === 'dashboard' ? 'active' : ''}`}
       aria-current={activePage === 'dashboard' ? 'page' : undefined}>
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
      </svg>
      <span>Dashboard</span>
    </a>

    <a href="/monitoring"
       class={`nav-link ${activePage === 'monitoring' ? 'active' : ''}`}
       aria-current={activePage === 'monitoring' ? 'page' : undefined}>
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/>
      </svg>
      <span>Live Monitoring</span>
      <span class="nav-badge" aria-label="4 active alerts">4</span>
    </a>

    <a href="/incidents"
       class={`nav-link ${activePage === 'incidents' ? 'active' : ''}`}
       aria-current={activePage === 'incidents' ? 'page' : undefined}>
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <span>Incidents</span>
      <span class="nav-badge" aria-label="7 open incidents">7</span>
    </a>

    <span class="sidebar-section-label">Site</span>

    <a href="/cameras"
       class={`nav-link ${activePage === 'cameras' ? 'active' : ''}`}
       aria-current={activePage === 'cameras' ? 'page' : undefined}>
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M23 7 16 12 23 17V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/>
      </svg>
      <span>Cameras</span>
    </a>

    <a href="/zones"
       class={`nav-link ${activePage === 'zones' ? 'active' : ''}`}
       aria-current={activePage === 'zones' ? 'page' : undefined}>
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/>
        <line x1="12" y1="22" x2="12" y2="15.5"/><line x1="22" y1="8.5" x2="12" y2="15.5"/>
        <line x1="2"  y1="8.5" x2="12" y2="15.5"/>
      </svg>
      <span>Safety Zones</span>
    </a>

    <span class="sidebar-section-label">Intelligence</span>

    <a href="/analytics"
       class={`nav-link ${activePage === 'analytics' ? 'active' : ''}`}
       aria-current={activePage === 'analytics' ? 'page' : undefined}>
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
        <line x1="6"  y1="20" x2="6"  y2="14"/>
      </svg>
      <span>Analytics</span>
    </a>

    <a href="/reports"
       class={`nav-link ${activePage === 'reports' ? 'active' : ''}`}
       aria-current={activePage === 'reports' ? 'page' : undefined}>
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
      </svg>
      <span>Reports</span>
    </a>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-footer">
      <a href="/settings"
         class={`nav-link ${activePage === 'settings' ? 'active' : ''}`}
         aria-current={activePage === 'settings' ? 'page' : undefined}>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        <span>Settings</span>
      </a>
    </div>
  </nav>

  <!-- ════════════════════════════════════════════
       MAIN CONTENT
  ════════════════════════════════════════════ -->
  <main class="app-content" id="main-content" tabindex="-1">
    <div class={fullBleed ? '' : 'page-wrap'}>
      <slot />
    </div>
  </main>

</div>

<!-- ════════════════════════════════════════════
     INCIDENT INVESTIGATION DRAWER
════════════════════════════════════════════ -->
<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

<aside
  class="incident-drawer"
  id="incident-drawer"
  role="complementary"
  aria-label="Incident Investigation"
  aria-hidden="true"
>
  <div class="drawer-header">
    <div class="drawer-title-area">
      <div class="drawer-id" id="drawer-incident-id">INC-0248</div>
      <h2 class="drawer-title" id="drawer-incident-title">No Hard Hat Detected</h2>
    </div>
    <span class="badge badge-critical" id="drawer-severity-badge">CRITICAL</span>
    <button class="btn-icon" id="close-drawer" aria-label="Close incident drawer" style="margin-left:8px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="drawer-body">

    <!-- Evidence Section -->
    <section aria-labelledby="evidence-heading">
      <div class="drawer-section-title" id="evidence-heading">Evidence</div>

      <!-- Evidence snapshot (simulated frame) -->
      <div style="position:relative;border-radius:8px;overflow:hidden;aspect-ratio:16/9;background:#060d1a;margin-bottom:10px;">
        <div style="width:100%;height:100%;background:linear-gradient(160deg,#060d1a 0%,#0d1c38 100%);position:relative;">
          <div class="scan-line"></div>
          <!-- Simulated scene -->
          <svg width="100%" height="100%" viewBox="0 0 400 225" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;opacity:0.6;">
            <rect y="160" width="400" height="65" fill="#0a1220"/>
            <rect x="80" y="50" width="160" height="110" fill="#091528" stroke="#152238" stroke-width="1"/>
            <line x1="0" y1="160" x2="400" y2="160" stroke="#152238" stroke-width="1" opacity="0.7"/>
            <!-- Worker figure (no helmet) -->
            <circle cx="200" cy="95" r="12" fill="#1a2d44" stroke="#EF4444" stroke-width="1.5"/>
            <rect x="192" y="107" width="16" height="25" rx="3" fill="#1a2d44" stroke="#EF4444" stroke-width="1.5"/>
          </svg>
          <!-- Detection box -->
          <div style="position:absolute;left:42%;top:30%;width:18%;height:38%;border:2px solid var(--color-critical);border-radius:2px;box-shadow:0 0 8px var(--color-critical-glow);">
            <div style="position:absolute;top:-18px;left:-2px;background:var(--color-critical);color:#fff;font-family:var(--font-mono);font-size:9px;padding:1px 6px;border-radius:2px;white-space:nowrap;">
              NO HELMET · 98%
            </div>
          </div>
          <!-- Camera meta -->
          <div style="position:absolute;bottom:6px;left:6px;font-family:var(--font-mono);font-size:9px;color:rgba(6,182,212,0.8);">
            CAM-04 · SECTOR B · SIMULATED DEMO FEED
          </div>
          <!-- HUD corners -->
          <div class="hud-corner hud-tl"></div>
          <div class="hud-corner hud-br"></div>
        </div>
      </div>

      <!-- Evidence details grid -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
        {[
          { label:'Camera',     value:'CAM-04', id:'drawer-cam' },
          { label:'Location',   value:'Sector B — Crane Zone', id:'drawer-loc' },
          { label:'Timestamp',  value:'14:43:17', id:'drawer-ts' },
          { label:'Confidence', value:'98%', id:'drawer-conf' },
          { label:'Rule',       value:'PPE_HELMET_REQUIRED', id:'drawer-rule' },
          { label:'Track ID',   value:'TRACK-024', id:'drawer-track' },
        ].map(item => (
          <div style="padding:8px 10px;background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:6px;">
            <div class="tech-label" style="margin-bottom:3px;">{item.label}</div>
            <div style="font-size:var(--text-sm);font-weight:var(--weight-semibold);font-family:var(--font-mono);" id={item.id}>{item.value}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- AI vs Human Detection State -->
    <section aria-labelledby="detection-heading">
      <div class="drawer-section-title" id="detection-heading">Detection Status</div>
      <div class="detection-state ai-detected" id="drawer-detection-state">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-warning);flex-shrink:0;" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <div>
          <div style="font-size:var(--text-sm);font-weight:var(--weight-semibold);" id="drawer-ai-state">AI DETECTED — REVIEW REQUIRED</div>
          <div style="font-size:var(--text-xxs);color:var(--color-text-tertiary);margin-top:2px;">
            Awaiting supervisor confirmation. AI confidence: 98%.
          </div>
        </div>
      </div>
    </section>

    <!-- Incident Timeline -->
    <section aria-labelledby="timeline-heading">
      <div class="drawer-section-title" id="timeline-heading">Timeline</div>
      <ol class="incident-timeline" id="drawer-timeline">
        <li class="timeline-event">
          <div class="timeline-dot critical" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--color-critical)" stroke-width="3"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
          </div>
          <div class="timeline-content">
            <div class="timeline-label">AI Detection</div>
            <div class="timeline-time">14:43:17 — No helmet detected (98% confidence)</div>
          </div>
        </li>
        <li class="timeline-event">
          <div class="timeline-dot critical" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--color-critical)" stroke-width="3"><circle cx="12" cy="12" r="5"/></svg>
          </div>
          <div class="timeline-content">
            <div class="timeline-label">Alert Generated</div>
            <div class="timeline-time">14:43:18 — Rule PPE_HELMET_REQUIRED triggered</div>
          </div>
        </li>
        <li class="timeline-event">
          <div class="timeline-dot primary" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-hover)" stroke-width="3"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07"/></svg>
          </div>
          <div class="timeline-content">
            <div class="timeline-label">Notification Sent</div>
            <div class="timeline-time">14:43:19 — Site Supervisor S. Chen notified</div>
          </div>
        </li>
      </ol>
    </section>

  </div>

  <!-- Action Bar -->
  <div class="action-bar" role="group" aria-label="Incident actions">
    <button class="btn btn-ghost" id="action-acknowledge" aria-describedby="drawer-incident-id">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      Acknowledge
    </button>
    <button class="btn btn-ghost" id="action-assign">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
      </svg>
      Assign
    </button>
    <button class="btn btn-ghost" id="action-camera">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M23 7 16 12 23 17V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/>
      </svg>
      View Live
    </button>
    <button class="btn btn-safe" id="action-resolve">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      Resolve
    </button>
  </div>
</aside>

<!-- ════════════════════════════════════════════
     DEMO CONTROLS
════════════════════════════════════════════ -->
<div class="demo-controls" role="region" aria-label="Demo controls">
  <div class="demo-controls-label">Demo Controls</div>
  <button class="btn btn-critical btn-sm" id="demo-simulate-btn" style="width:100%;justify-content:center;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
      <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    Simulate Critical Alert
  </button>
  <button class="btn btn-ghost btn-sm" id="demo-resolve-btn" style="width:100%;justify-content:center;">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    Simulate Resolution
  </button>
</div>

<script>
  // ── Notification dropdown ──────────────────────────────
  const notifBtn = document.getElementById('notif-btn')!;
  const notifDropdown = document.getElementById('notif-dropdown')!;

  notifBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = notifDropdown.classList.toggle('open');
    notifBtn.setAttribute('aria-expanded', String(isOpen));
  });
  document.addEventListener('click', (e) => {
    if (!document.getElementById('notif-wrap')!.contains(e.target as Node)) {
      notifDropdown.classList.remove('open');
      notifBtn.setAttribute('aria-expanded', 'false');
    }
  });

  // ── Incident Drawer ────────────────────────────────────
  const drawer = document.getElementById('incident-drawer')!;
  const backdrop = document.getElementById('drawer-backdrop')!;
  const closeBtn = document.getElementById('close-drawer')!;

  function openDrawer(data?: Record<string, string>) {
    drawer.classList.add('open');
    backdrop.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();

    // Update drawer content if data provided
    if (data) {
      const fields = {
        'drawer-incident-id':    data.id,
        'drawer-incident-title': data.detection,
        'drawer-cam':            data.camera,
        'drawer-loc':            data.location,
        'drawer-conf':           data.confidence + '%',
        'drawer-ts':             data.timestamp,
      };
      Object.entries(fields).forEach(([id, val]) => {
        const el = document.getElementById(id);
        if (el && val) el.textContent = val;
      });

      const badge = document.getElementById('drawer-severity-badge');
      if (badge) {
        badge.className = `badge badge-${data.severity === 'critical' ? 'critical' : data.severity === 'high' ? 'warning' : 'primary'}`;
        badge.textContent = data.severity?.toUpperCase() ?? 'CRITICAL';
      }
    }
  }

  function closeDrawer() {
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    backdrop.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeDrawer);
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });

  // Expose globally for page scripts
  (window as any).__openIncidentDrawer = openDrawer;
  (window as any).__closeIncidentDrawer = closeDrawer;

  // ── Delegate: alert/incident clicks → open drawer ─────
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const alertEl = target.closest('[data-open-drawer]');
    if (alertEl) {
      const data = (alertEl as HTMLElement).dataset;
      openDrawer({
        id:         data.incidentId ?? 'INC-0248',
        detection:  data.detection ?? 'No Hard Hat Detected',
        camera:     data.camera ?? 'CAM-04',
        location:   data.location ?? 'Sector B — Crane Zone',
        confidence: data.confidence ?? '98',
        timestamp:  data.timestamp ?? '14:43:17',
        severity:   data.severity ?? 'critical',
      });
    }
  });

  // ── Drawer action buttons ──────────────────────────────
  document.getElementById('action-acknowledge')?.addEventListener('click', () => {
    const el = document.getElementById('drawer-ai-state');
    const stateEl = document.getElementById('drawer-detection-state');
    if (el) el.textContent = 'ACKNOWLEDGED BY SUPERVISOR';
    if (stateEl) { stateEl.className = 'detection-state primary'; }
  });

  document.getElementById('action-resolve')?.addEventListener('click', () => {
    const el = document.getElementById('drawer-ai-state');
    const stateEl = document.getElementById('drawer-detection-state');
    if (el) el.textContent = 'RESOLVED — PPE CONFIRMED';
    if (stateEl) { stateEl.className = 'detection-state confirmed'; }
    setTimeout(() => closeDrawer(), 1200);
  });

  // ── Demo Controls ─────────────────────────────────────
  document.getElementById('demo-simulate-btn')?.addEventListener('click', () => {
    if ((window as any).__sitesage_simulate_critical) {
      (window as any).__sitesage_simulate_critical();
    }
    // Also open the drawer directly for the demo flow
    openDrawer({
      id: `INC-0${Math.floor(Math.random() * 50) + 250}`,
      detection: 'No Hard Hat Detected',
      camera: 'CAM-04',
      location: 'Sector B — Crane Zone',
      confidence: '98',
      timestamp: new Date().toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', second:'2-digit' }),
      severity: 'critical',
    });
  });

  document.getElementById('demo-resolve-btn')?.addEventListener('click', () => {
    if (drawer.classList.contains('open')) {
      document.getElementById('action-resolve')?.click();
    }
  });

  // ── Live clock on page ─────────────────────────────────
  function updateClock() {
    const t = new Date().toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    document.querySelectorAll('[data-live-clock]').forEach(el => el.textContent = t);
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>

</body>
</html>
