---
/**
 * SiteSage — Live Monitoring
 * Route: /monitoring
 * Multi-camera operational overview grid
 */
import Layout from '../layouts/Layout.astro';
import HumanoidWorker from '../components/HumanoidWorker.astro';

const cameras = [
  { id:'CAM-01', name:'North Tower — Level 08', sector:'A', status:'online',  compliance:97, fps:30, res:'1080p', incidents:1, workers:8,  threat:'low'  },
  { id:'CAM-02', name:'North Tower — Level 12', sector:'A', status:'online',  compliance:94, fps:30, res:'4K',    incidents:2, workers:12, threat:'medium' },
  { id:'CAM-03', name:'Sector B — Main Entry',  sector:'B', status:'online',  compliance:88, fps:25, res:'1080p', incidents:4, workers:7,  threat:'high'  },
  { id:'CAM-04', name:'Sector B — Crane Zone',  sector:'B', status:'online',  compliance:81, fps:30, res:'1080p', incidents:7, workers:4,  threat:'critical' },
  { id:'CAM-05', name:'South Tower — Gate C',   sector:'C', status:'online',  compliance:96, fps:15, res:'720p',  incidents:1, workers:6,  threat:'low'  },
  { id:'CAM-06', name:'Loading Bay — East',     sector:'D', status:'warning', compliance:72, fps:12, res:'1080p', incidents:3, workers:9,  threat:'high'  },
  { id:'CAM-07', name:'Material Yard — North',  sector:'D', status:'offline', compliance:0,  fps:0,  res:'1080p', incidents:0, workers:0,  threat:'none' },
  { id:'CAM-08', name:'Perimeter — South',      sector:'E', status:'online',  compliance:99, fps:30, res:'4K',    incidents:0, workers:2,  threat:'low'  },
];

const threatBadge = (t: string) => {
  if (t === 'critical') return 'badge-critical';
  if (t === 'high')     return 'badge-warning';
  if (t === 'medium')   return 'badge-primary';
  if (t === 'low')      return 'badge-safe';
  return 'badge-neutral';
};
---

<Layout
  title="Live Monitoring"
  breadcrumb={['Site Dashboard', 'Live Monitoring']}
  activePage="monitoring"
>

<!-- PAGE HEADER -->
<div class="page-header">
  <div>
    <h1 class="page-title">Live Monitoring</h1>
    <p class="page-subtitle">8 camera feeds — real-time AI detection active</p>
  </div>
  <div class="page-actions">
    <select class="input" style="width:auto;height:32px;font-size:var(--text-xs);" aria-label="Layout columns">
      <option>2 × 4 Grid</option>
      <option>2 × 2 Grid</option>
      <option>List View</option>
    </select>
    <button class="btn btn-primary btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M23 7 16 12 23 17V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/>
      </svg>
      Add Camera
    </button>
  </div>
</div>

<!-- SITE STATUS STRIP -->
<div class="ops-status-strip" role="status">
  <div class="ops-status-item">
    <span class="status-dot safe" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Online</div>
      <div class="ops-status-value safe">6</div>
    </div>
  </div>
  <div class="ops-status-item">
    <span class="status-dot warning" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Warning</div>
      <div class="ops-status-value warning">1</div>
    </div>
  </div>
  <div class="ops-status-item">
    <span class="status-dot offline" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Offline</div>
      <div class="ops-status-value" style="color:var(--color-text-disabled);">1</div>
    </div>
  </div>
  <div class="ops-status-item">
    <div>
      <div class="ops-status-label">AI Active</div>
      <div class="ops-status-value primary">7 Feeds</div>
    </div>
  </div>
  <div class="ops-status-item">
    <div>
      <div class="ops-status-label">Total Workers</div>
      <div class="ops-status-value">48</div>
    </div>
  </div>
  <div class="ops-status-item">
    <div>
      <div class="ops-status-label">Avg Latency</div>
      <div class="ops-status-value safe">28ms</div>
    </div>
  </div>
</div>

<!-- CAMERA GRID -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;" role="list" aria-label="Camera feeds">
  {cameras.map(cam => (
    <article class="card"
             role="listitem"
             style={`overflow:hidden;${cam.threat === 'critical' ? 'animation:pulse-critical 2.4s ease-in-out infinite;border-color:var(--color-critical-dark);' : cam.threat === 'high' ? 'border-color:rgba(245,158,11,0.3);' : ''}`}
             aria-label={`${cam.id} — ${cam.name}. Status: ${cam.status}. Compliance: ${cam.compliance}%.`}>

      <!-- Camera Feed Area -->
      <div style="position:relative;aspect-ratio:16/9;background:#060d1a;overflow:hidden;cursor:pointer;"
           role="button"
           tabindex="0"
           aria-label={`Click to view ${cam.id} full screen`}
           data-open-drawer={cam.threat === 'critical' ? '' : undefined}
           data-detection={cam.threat === 'critical' ? 'No Hard Hat Detected' : undefined}
           data-camera={cam.id}
           data-location={cam.name}
           data-confidence={cam.threat === 'critical' ? '98' : undefined}
           data-severity={cam.threat === 'critical' ? 'critical' : cam.threat}>
        {cam.status === 'offline' ? (
          <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:#060d1a;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-disabled)" stroke-width="1.5" aria-hidden="true">
              <line x1="1" y1="1" x2="23" y2="23"/>
              <path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"/>
              <path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"/>
            </svg>
            <span style="font-size:9px;font-weight:700;letter-spacing:0.06em;color:var(--color-text-disabled);text-transform:uppercase;">Stream Offline</span>
            <span style="font-size:8px;color:var(--color-text-disabled);">Last heartbeat: 47m ago</span>
          </div>
        ) : (
          <>
            <svg width="100%" height="100%" viewBox="0 0 280 157" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <rect width="280" height="157" fill="#060d1a"/>
              {[0,1,2,3].map(i => <line x1={70*i} y1="0" x2={70*i} y2="157" stroke="#0a1625" stroke-width="0.5"/>)}
              {[0,1,2].map(i => <line x1="0" y1={52*i+20} x2="280" y2={52*i+20} stroke="#0a1625" stroke-width="0.5"/>)}
              <rect x="30" y="20" width="120" height="110" fill="#091528" stroke="#152238" stroke-width="0.5"/>
              {/* Articulated Humanoid Tradespeople on Camera Feed */}
              {Array.from({length:Math.min(cam.workers,3)},(_,i) => {
                const cx = 35 + i * 70;
                const isViolation = cam.threat === 'critical' && i === 0;
                return (
                  <HumanoidWorker
                    x={cx}
                    y={25}
                    scale={0.7}
                    pose={i === 0 ? (isViolation ? 'walking-tool' : 'standing-tablet') : i === 1 ? 'walking-tool' : 'rigging-signal'}
                    hasHelmet={!isViolation}
                    helmetColor={i === 0 ? '#EAB308' : i === 1 ? '#FFFFFF' : '#38BDF8'}
                    vestColor={isViolation ? 'orange' : 'lime'}
                    isAlert={isViolation}
                  />
                );
              })}
            </svg>
            {cam.status === 'warning' && (
              <div style="position:absolute;inset:0;background:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(245,158,11,0.03) 10px,rgba(245,158,11,0.03) 20px);pointer-events:none;" aria-hidden="true"></div>
            )}
            <div style="position:absolute;left:0;width:100%;height:1.5px;background:linear-gradient(90deg,transparent 0%,rgba(6,182,212,0.4) 50%,transparent 100%);animation:scan-line 5s linear infinite;opacity:0;pointer-events:none;" aria-hidden="true"></div>
          </>
        )}

        <!-- Threat indicator overlay -->
        {cam.threat === 'critical' && (
          <div style="position:absolute;inset:0;border:2px solid var(--color-critical);pointer-events:none;border-radius:0;animation:pulse-critical 2.4s ease-in-out infinite;" aria-hidden="true"></div>
        )}

        <!-- Camera label bottom -->
        <div style="position:absolute;bottom:0;left:0;right:0;padding:5px 8px;background:linear-gradient(transparent,rgba(0,0,0,0.7));display:flex;align-items:center;justify-content:space-between;">
          <span style="font-family:var(--font-mono);font-size:8px;color:rgba(6,182,212,0.9);">{cam.id}</span>
          {cam.status !== 'offline' && <span style="font-family:var(--font-mono);font-size:8px;color:rgba(255,255,255,0.4);">{cam.fps}fps</span>}
        </div>

        <!-- HUD corners on active feeds -->
        {cam.status !== 'offline' && (
          <>
            <div class="hud-corner hud-tl" aria-hidden="true"></div>
            <div class="hud-corner hud-br" aria-hidden="true"></div>
          </>
        )}

        {/* Hover expand overlay */}
        <div style="position:absolute;inset:0;background:rgba(37,99,235,0.1);border:1px solid var(--color-primary);opacity:0;transition:opacity 0.15s;pointer-events:none;" class="cam-grid-overlay" aria-hidden="true"></div>
      </div>

      <!-- Camera metadata footer -->
      <div style="padding:10px 12px;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:6px;margin-bottom:7px;">
          <div>
            <div style="font-size:var(--text-sm);font-weight:var(--weight-semibold);line-height:1.3;">{cam.name}</div>
            <div style="font-size:var(--text-xxs);color:var(--color-text-tertiary);font-family:var(--font-mono);margin-top:1px;">Sector {cam.sector} · {cam.res}</div>
          </div>
          <span class={`badge ${threatBadge(cam.threat)}`} style="font-size:9px;flex-shrink:0;">
            {cam.threat === 'none' ? '—' : cam.threat.toUpperCase()}
          </span>
        </div>

        {/* Compliance meter */}
        {cam.status !== 'offline' && (
          <div style="margin-bottom:7px;">
            <div style="display:flex;justify-content:space-between;margin-bottom:3px;">
              <span class="tech-label">Compliance</span>
              <span style={`font-size:9px;font-weight:var(--weight-bold);color:${cam.compliance >= 90 ? 'var(--color-safe)' : cam.compliance >= 75 ? 'var(--color-warning)' : 'var(--color-critical)'};`}>
                {cam.compliance}%
              </span>
            </div>
            <div style="height:3px;background:var(--color-border);border-radius:var(--radius-full);overflow:hidden;" role="progressbar" aria-valuenow={cam.compliance} aria-valuemin={0} aria-valuemax={100} aria-label={`Compliance: ${cam.compliance}%`}>
              <div style={`height:100%;width:${cam.compliance}%;background:${cam.compliance >= 90 ? 'var(--color-safe)' : cam.compliance >= 75 ? 'var(--color-warning)' : 'var(--color-critical)'};border-radius:var(--radius-full);`}></div>
            </div>
          </div>
        )}

        {/* Footer meta row */}
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <div style="display:flex;align-items:center;gap:5px;">
            <span class={`status-dot ${cam.status === 'online' ? 'safe' : cam.status === 'warning' ? 'warning' : 'offline'}`} aria-hidden="true"></span>
            <span style="font-size:var(--text-xxs);color:var(--color-text-tertiary);">
              {cam.status === 'online' ? 'Online' : cam.status === 'warning' ? 'Degraded' : 'Offline'}
            </span>
          </div>
          {cam.incidents > 0 && (
            <span style={`font-size:9px;font-weight:var(--weight-bold);color:${cam.incidents > 4 ? 'var(--color-critical)' : 'var(--color-warning)'};`}>
              {cam.incidents} incident{cam.incidents > 1 ? 's' : ''}
            </span>
          )}
          <div style="display:flex;gap:3px;">
            <button class="btn-icon" style="width:24px;height:24px;" title="View full screen" aria-label={`View ${cam.id} full screen`}>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            </button>
            <button class="btn-icon" style="width:24px;height:24px;" title="Camera settings" aria-label={`Settings for ${cam.id}`}>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33"/></svg>
            </button>
          </div>
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  article:hover .cam-grid-overlay { opacity: 1; }
  @keyframes scan-line {
    0%   { top: -2px; opacity: 0; }
    5%   { opacity: 0.6; }
    95%  { opacity: 0.3; }
    100% { top: 100%; opacity: 0; }
  }
  @media (max-width: 1200px) {
    div[style*="grid-template-columns:repeat(4"] {
      grid-template-columns: repeat(3,1fr) !important;
    }
  }
  @media (max-width: 900px) {
    div[style*="grid-template-columns:repeat(4"] {
      grid-template-columns: repeat(2,1fr) !important;
    }
  }
</style>

</Layout>
