---
/**
 * SiteSage — Analytics
 * Route: /analytics
 * AI model performance + compliance intelligence
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Analytics"
  breadcrumb={['Site Dashboard', 'Analytics']}
  activePage="analytics"
>

<div class="page-header">
  <div>
    <h1 class="page-title">Safety Analytics</h1>
    <p class="page-subtitle">AI model performance, compliance trends, and site intelligence</p>
  </div>
  <div class="page-actions">
    <select class="input" style="width:auto;height:32px;font-size:var(--text-xs);" aria-label="Time period">
      <option>Last 24 Hours</option>
      <option>Last 7 Days</option>
      <option>Last 30 Days</option>
    </select>
    <button class="btn btn-primary btn-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Export
    </button>
  </div>
</div>

<!-- KPI STRIP -->
<div class="ops-status-strip" role="status">
  {[
    { label:'Detection Accuracy', value:'97.4%', color:'var(--color-safe)',    delta:'▲ +0.3%' },
    { label:'Avg Inference',       value:'28ms',  color:'var(--color-safe)',    delta:'▼ −4ms' },
    { label:'False Positive Rate', value:'2.6%',  color:'var(--color-warning)', delta:'▼ −0.8%' },
    { label:'Total Incidents',     value:'38',    color:'var(--color-critical)', delta:'▲ +7 this week' },
    { label:'Resolved Rate',       value:'84%',   color:'var(--color-primary-hover)', delta:'▲ +12%' },
    { label:'Camera Uptime',       value:'99.1%', color:'var(--color-safe)',    delta:'▲ stable' },
  ].map(s => (
    <div class="ops-status-item">
      <div>
        <div class="ops-status-label">{s.label}</div>
        <div class="ops-status-value" style={`color:${s.color};`}>{s.value}</div>
        <div style="font-size:9px;color:var(--color-text-tertiary);margin-top:1px;">{s.delta}</div>
      </div>
    </div>
  ))}
</div>

<!-- MAIN CHARTS GRID -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

  <!-- Compliance Trend -->
  <div class="card">
    <div class="panel-header">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-safe)" stroke-width="2" aria-hidden="true">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
      </svg>
      <span class="panel-title">Safety Compliance — 7 Days</span>
      <span class="kpi-chip kpi-safe" style="margin-left:auto;font-size:9px;">94.2% Current</span>
    </div>
    <div class="chart-area" style="padding:16px 16px 10px;" role="img" aria-label="Safety compliance trend over 7 days">
      <svg width="100%" height="140" viewBox="0 0 480 140" preserveAspectRatio="none">
        <defs>
          <linearGradient id="comp-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="rgba(16,185,129,0.2)"/>
            <stop offset="100%" stop-color="rgba(16,185,129,0)"/>
          </linearGradient>
        </defs>
        <!-- Gridlines -->
        {[28,56,84,112].map(y => (
          <line x1="0" y1={y} x2="480" y2={y} stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
        ))}
        <!-- Target line at 95% -->
        <line x1="0" y1="21" x2="480" y2="21" stroke="rgba(16,185,129,0.15)" stroke-width="1" stroke-dasharray="4,4"/>
        <text x="482" y="25" font-size="8" fill="rgba(16,185,129,0.4)" font-family="monospace">95%</text>
        <!-- Data curve: Mon=88 Tue=91 Wed=87 Thu=93 Fri=94 Sat=92 Sun=94 -->
        <polyline
          points="0,62 68,42 137,69 205,28 274,21 342,35 411,21 480,21"
          fill="none" stroke="#10B981" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
        <polygon
          points="0,62 68,42 137,69 205,28 274,21 342,35 411,21 480,21 480,140 0,140"
          fill="url(#comp-grad)"/>
        {[{x:0,y:62,v:'88%'},{x:68,y:42,v:'91%'},{x:137,y:69,v:'87%'},{x:205,y:28,v:'93%'},{x:274,y:21,v:'94%'},{x:342,y:35,v:'92%'},{x:411,y:21,v:'94%'},{x:480,y:21,v:'94.2%'}].map(p => (
          <>
            <circle cx={p.x} cy={p.y} r="3.5" fill="#10B981" stroke="#060d1a" stroke-width="1.5"/>
          </>
        ))}
      </svg>
      <div style="display:flex;justify-content:space-between;margin-top:6px;">
        {['Mon','Tue','Wed','Thu','Fri','Sat','Sun','Today'].map((d,i) => (
          <span style="font-size:8px;color:var(--color-text-tertiary);text-align:center;">{d}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Incident Trend -->
  <div class="card">
    <div class="panel-header">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-warning)" stroke-width="2" aria-hidden="true">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
      <span class="panel-title">Incidents by Day — 7 Days</span>
      <span class="kpi-chip kpi-critical" style="margin-left:auto;font-size:9px;">38 Total</span>
    </div>
    <div class="chart-area" style="padding:16px 16px 10px;" role="img" aria-label="Incident count by day">
      <div style="display:flex;align-items:flex-end;gap:10px;height:140px;">
        {[
          { d:'Mon', crit:3, high:2, med:1, total:6  },
          { d:'Tue', crit:4, high:3, med:2, total:9  },
          { d:'Wed', crit:2, high:1, med:1, total:4  },
          { d:'Thu', crit:5, high:2, med:1, total:8  },
          { d:'Fri', crit:2, high:3, med:0, total:5  },
          { d:'Sat', crit:1, high:1, med:1, total:3  },
          { d:'Sun', crit:1, high:1, med:1, total:3  },
        ].map(day => {
          const maxH = 120;
          const scale = day.total / 9;
          return (
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;">
              <div style="width:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:120px;gap:1px;">
                <div style={`width:100%;height:${(day.crit/9)*120}px;background:var(--color-critical);border-radius:3px 3px 0 0;opacity:0.85;`} title={`Critical: ${day.crit}`}></div>
                <div style={`width:100%;height:${(day.high/9)*120}px;background:var(--color-warning);opacity:0.8;`} title={`High: ${day.high}`}></div>
                <div style={`width:100%;height:${(day.med/9)*120}px;background:var(--color-primary);border-radius:0 0 3px 3px;opacity:0.7;`} title={`Medium: ${day.med}`}></div>
              </div>
              <span style="font-size:8px;color:var(--color-text-tertiary);">{day.d}</span>
              <span style="font-size:8px;font-weight:var(--weight-bold);color:var(--color-text-secondary);">{day.total}</span>
            </div>
          );
        })}
      </div>
      <!-- Legend -->
      <div style="display:flex;gap:12px;margin-top:8px;">
        {[{c:'var(--color-critical)',l:'Critical'},{c:'var(--color-warning)',l:'High'},{c:'var(--color-primary-hover)',l:'Medium'}].map(l => (
          <div style="display:flex;align-items:center;gap:4px;">
            <div style={`width:8px;height:8px;border-radius:1px;background:${l.c};`} aria-hidden="true"></div>
            <span style="font-size:9px;color:var(--color-text-tertiary);">{l.l}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

</div>

<!-- PPE + MODEL ROW -->
<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">

  <!-- PPE Breakdown -->
  <div class="card">
    <div class="panel-header">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-hover)" stroke-width="1.8" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <span class="panel-title">PPE Compliance by Type</span>
    </div>
    <div style="padding:12px 14px;display:flex;flex-direction:column;gap:10px;">
      {[
        { label:'Hard Hat',      pct:97, compliant:138, total:142, color:'var(--color-safe)' },
        { label:'Safety Vest',   pct:92, compliant:130, total:142, color:'var(--color-safe)' },
        { label:'Safety Boots',  pct:99, compliant:140, total:142, color:'var(--color-safe)' },
        { label:'Gloves',        pct:83, compliant:118, total:142, color:'var(--color-warning)' },
        { label:'Eye Protection',pct:67, compliant:95,  total:142, color:'var(--color-critical)' },
        { label:'Harness',       pct:82, compliant:28,  total:34,  color:'var(--color-warning)' },
      ].map(item => (
        <div>
          <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
            <span style="font-size:var(--text-xs);color:var(--color-text-secondary);">{item.label}</span>
            <div style="display:flex;align-items:center;gap:8px;">
              <span class="tech-label">{item.compliant}/{item.total}</span>
              <span style={`font-size:var(--text-xs);font-weight:var(--weight-bold);color:${item.color};min-width:30px;text-align:right;`}>{item.pct}%</span>
            </div>
          </div>
          <div style="height:5px;background:var(--color-border);border-radius:var(--radius-full);overflow:hidden;">
            <div style={`height:100%;width:${item.pct}%;background:${item.color};border-radius:var(--radius-full);transition:width 0.8s ease;`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Violation Distribution donut -->
  <div class="card">
    <div class="panel-header">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-critical)" stroke-width="1.8" aria-hidden="true">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <span class="panel-title">Violation Type Distribution</span>
    </div>
    <div style="padding:14px;display:flex;align-items:center;gap:16px;">
      <svg width="150" height="150" viewBox="0 0 150 150" role="img" aria-label="Violation distribution donut chart">
        <circle cx="75" cy="75" r="52" fill="none" stroke="var(--color-border)" stroke-width="20"/>
        <!-- No Helmet: 34% = 113.6deg -->
        <circle cx="75" cy="75" r="52" fill="none" stroke="#EF4444" stroke-width="20"
          stroke-dasharray="113.7 212.9" stroke-dashoffset="0" transform="rotate(-90 75 75)"/>
        <!-- No Vest: 26% = 86.7deg -->
        <circle cx="75" cy="75" r="52" fill="none" stroke="#F59E0B" stroke-width="20"
          stroke-dasharray="87.1 212.9" stroke-dashoffset="-113.7" transform="rotate(-90 75 75)"/>
        <!-- Zone: 21% = 70.1deg -->
        <circle cx="75" cy="75" r="52" fill="none" stroke="#3B82F6" stroke-width="20"
          stroke-dasharray="70.3 212.9" stroke-dashoffset="-200.8" transform="rotate(-90 75 75)"/>
        <!-- Other: 19% -->
        <circle cx="75" cy="75" r="52" fill="none" stroke="#6B7280" stroke-width="20"
          stroke-dasharray="63.9 212.9" stroke-dashoffset="-271.1" transform="rotate(-90 75 75)"/>
        <text x="75" y="71" text-anchor="middle" font-size="16" font-weight="800" fill="#F9FAFB" font-family="Manrope">38</text>
        <text x="75" y="85" text-anchor="middle" font-size="8" fill="#9CA3AF" font-family="monospace">INCIDENTS</text>
      </svg>
      <div style="display:flex;flex-direction:column;gap:8px;flex:1;">
        {[
          { c:'#EF4444', label:'No Helmet',  pct:34, n:13 },
          { c:'#F59E0B', label:'No Vest',    pct:26, n:10 },
          { c:'#3B82F6', label:'Zone Breach',pct:21, n:8 },
          { c:'#6B7280', label:'Other PPE',  pct:19, n:7 },
        ].map(item => (
          <div style="display:flex;align-items:center;gap:6px;">
            <div style={`width:8px;height:8px;border-radius:2px;background:${item.c};flex-shrink:0;`} aria-hidden="true"></div>
            <span style="font-size:var(--text-xs);flex:1;color:var(--color-text-secondary);">{item.label}</span>
            <span class="tech-label">{item.n}</span>
            <span style={`font-size:var(--text-xs);font-weight:var(--weight-bold);color:${item.c};min-width:28px;text-align:right;`}>{item.pct}%</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Model Performance -->
  <div class="card">
    <div class="panel-header">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.8" aria-hidden="true">
        <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46"/>
      </svg>
      <span class="panel-title">AI Model Performance</span>
    </div>
    <div style="padding:12px 14px;display:flex;flex-direction:column;gap:14px;">
      {[
        { label:'Detection Accuracy',  value:97.4, suffix:'%',  color:'var(--color-safe)',    max:100 },
        { label:'Recall Rate',         value:94.8, suffix:'%',  color:'var(--color-safe)',    max:100 },
        { label:'False Positive Rate', value:2.6,  suffix:'%',  color:'var(--color-warning)', max:10 },
        { label:'Avg Inference',       value:28,   suffix:'ms', color:'var(--color-cyan)',    max:50 },
        { label:'Frames Processed',    value:182,  suffix:'k',  color:'var(--color-primary-hover)', max:200 },
      ].map(m => (
        <div>
          <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
            <span style="font-size:var(--text-xs);color:var(--color-text-secondary);">{m.label}</span>
            <span style={`font-size:var(--text-xs);font-weight:var(--weight-bold);font-family:var(--font-mono);color:${m.color};`}>{m.value}{m.suffix}</span>
          </div>
          <div style="height:4px;background:var(--color-border);border-radius:var(--radius-full);overflow:hidden;">
            <div style={`height:100%;width:${Math.min((m.value/m.max)*100,100)}%;background:${m.color};border-radius:var(--radius-full);`}></div>
          </div>
        </div>
      ))}
      <div style="padding:8px;background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:6px;margin-top:2px;">
        <div class="tech-label">Model</div>
        <div style="font-size:var(--text-xs);font-weight:var(--weight-semibold);margin-top:2px;">YOLOv8 + ByteTrack</div>
        <div style="font-size:9px;color:var(--color-text-tertiary);margin-top:1px;">Last retrained: 2h ago</div>
      </div>
    </div>
  </div>

</div>

<!-- HEATMAP -->
<div class="card">
  <div class="panel-header">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>
    </svg>
    <span class="panel-title">Detection Activity Heatmap — Last 24 Hours by Camera</span>
  </div>
  <div style="padding:16px;overflow-x:auto;" role="img" aria-label="24-hour detection activity heatmap">
    <div style="min-width:600px;">
      <!-- Hour labels -->
      <div style="display:grid;grid-template-columns:56px repeat(24,1fr);gap:2px;margin-bottom:4px;">
        <div></div>
        {Array.from({length:24},(_,i) => (
          <div style="font-size:8px;text-align:center;color:var(--color-text-tertiary);font-family:monospace;">{String(i).padStart(2,'0')}</div>
        ))}
      </div>
      <!-- Camera rows -->
      {['CAM-01','CAM-02','CAM-03','CAM-04','CAM-05','CAM-06'].map((cam, ci) => {
        const baseline = [0.1,0.15,0.3,0.35,0.4,0.5,0.55,0.6,0.65,0.7,0.75,0.7,0.65,0.75,0.8,0.85,0.75,0.65,0.5,0.4,0.3,0.2,0.15,0.1];
        return (
          <div style="display:grid;grid-template-columns:56px repeat(24,1fr);gap:2px;margin-bottom:2px;">
            <div style="font-size:9px;font-family:monospace;color:var(--color-text-tertiary);display:flex;align-items:center;">{cam}</div>
            {Array.from({length:24},(_,hi) => {
              const intensity = Math.min(1, Math.max(0, baseline[hi] + (Math.random() * 0.3 - 0.15)));
              const color = intensity > 0.7 ? '#EF4444' : intensity > 0.4 ? '#F59E0B' : intensity > 0.15 ? '#10B981' : '#1F2937';
              return (
                <div style={`height:16px;border-radius:2px;background:${color};opacity:${0.2 + intensity * 0.8};`} title={`${cam} ${String(hi).padStart(2,'0')}:00`} role="cell"></div>
              );
            })}
          </div>
        );
      })}
      <!-- Legend -->
      <div style="display:flex;gap:12px;margin-top:10px;align-items:center;">
        <span style="font-size:9px;color:var(--color-text-tertiary);">Activity:</span>
        {[{c:'#10B981',l:'Low'},{c:'#F59E0B',l:'Medium'},{c:'#EF4444',l:'High'}].map(l => (
          <div style="display:flex;align-items:center;gap:4px;">
            <div style={`width:12px;height:12px;border-radius:2px;background:${l.c};`}></div>
            <span style="font-size:9px;color:var(--color-text-tertiary);">{l.l}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

</Layout>
