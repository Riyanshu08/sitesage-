---
/**
 * SiteSage — Reports & Regulatory Compliance Intelligence
 * Route: /reports
 * OSHA 1926 audits, shift summaries, and forensic incident exports
 */
import Layout from '../layouts/Layout.astro';

const reportTemplates = [
  {
    id: 'RPT-DAILY',
    title: 'Daily Shift Safety & Near-Miss Briefing',
    subtitle: 'Shift 01 & 02 aggregated safety audit and worker PPE compliance log',
    type: 'PDF',
    badgeClass: 'badge-primary',
    frequency: 'Automated Daily (18:00)',
    lastGenerated: 'Today, 14:02',
    size: '2.4 MB',
    records: 48,
    category: 'Operational',
  },
  {
    id: 'RPT-OSHA',
    title: 'OSHA 1926 Subpart C/E Compliance Dossier',
    subtitle: 'Head protection (1926.100), Eye/Face (1926.102), and Fall Arrest (1926.501)',
    type: 'PDF',
    badgeClass: 'badge-safe',
    frequency: 'Weekly Audit',
    lastGenerated: 'Sep 28, 2026',
    size: '8.1 MB',
    records: 142,
    category: 'Regulatory',
  },
  {
    id: 'RPT-GEOFENCE',
    title: 'Crane & Exclusion Zone Breach Forensic Package',
    subtitle: 'Synchronized CCTV video clips, GPS coordinates, and worker RFID log',
    type: 'ZIP',
    badgeClass: 'badge-critical',
    frequency: 'On-Demand / Incident-Triggered',
    lastGenerated: 'Today, 11:34',
    size: '42.8 MB',
    records: 12,
    category: 'Forensics',
  },
  {
    id: 'RPT-SUBCONTRACTOR',
    title: 'Subcontractor PPE Adherence League Table',
    subtitle: 'Adherence grading across SteelCorp, Apex Concrete, and Metro Cranes',
    type: 'CSV',
    badgeClass: 'badge-warning',
    frequency: 'Weekly Shift End',
    lastGenerated: 'Sep 26, 2026',
    size: '410 KB',
    records: 320,
    category: 'Contractor',
  },
  {
    id: 'RPT-CV-METRICS',
    title: 'Edge AI Computer Vision Calibration Audit',
    subtitle: 'YOLOv8x-PPE precision, recall curves, and false-positive telemetry',
    type: 'JSON',
    badgeClass: 'badge-neutral',
    frequency: 'Monthly Technical',
    lastGenerated: 'Sep 25, 2026',
    size: '1.2 MB',
    records: 1250,
    category: 'Technical',
  },
  {
    id: 'RPT-INCIDENT-LOG',
    title: 'Comprehensive 30-Day Site Incident Master',
    subtitle: 'Every flagged safety violation with supervisor sign-off notes',
    type: 'PDF',
    badgeClass: 'badge-primary',
    frequency: 'Monthly Formal',
    lastGenerated: 'Sep 01, 2026',
    size: '14.6 MB',
    records: 218,
    category: 'Operational',
  }
];

const subcontractorScores = [
  { name: 'Apex Concrete Ltd.', workers: 42, score: 98.4, violations: 1, status: 'safe' },
  { name: 'HighRise Electrical', workers: 18, score: 96.1, violations: 3, status: 'safe' },
  { name: 'SteelCorp Heavy Erectors', workers: 34, score: 88.2, violations: 9, status: 'warning' },
  { name: 'Metro Crane Specialists', workers: 12, score: 84.6, violations: 5, status: 'critical' },
];
---

<Layout
  title="Reports & Compliance"
  breadcrumb={['Site Dashboard', 'Reports & Compliance']}
  activePage="reports"
>

<!-- TOP BANNER -->
<div class="page-header">
  <div>
    <h1 class="page-title">Reports & Regulatory Compliance</h1>
    <p class="page-subtitle">Official OSHA 1926 documentation, automated shift digests & forensic audit packages</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-ghost btn-sm" id="btn-schedule-export">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      Schedules (3 Active)
    </button>
    <button class="btn btn-primary btn-sm" id="btn-custom-report">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Generate Report
    </button>
  </div>
</div>

<!-- COMPLIANCE METRIC STRIP -->
<div class="ops-status-strip" role="region" aria-label="Compliance Metrics">
  <div class="ops-status-item">
    <span class="status-dot safe" aria-hidden="true"></span>
    <div>
      <div class="ops-status-label">Site Compliance Rating</div>
      <div class="ops-status-value" style="color:var(--color-safe);">96.4% <span style="font-size:11px;color:var(--color-text-tertiary);font-weight:400;">(OSHA Grade A)</span></div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
    </svg>
    <div>
      <div class="ops-status-label">Archived Packages</div>
      <div class="ops-status-value">148 Dossiers</div>
    </div>
  </div>
  <div class="ops-status-item">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-warning)" stroke-width="2">
      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
    </svg>
    <div>
      <div class="ops-status-label">Next Auto-Dispatch</div>
      <div class="ops-status-value">Today at 18:00 UTC</div>
    </div>
  </div>
  <div class="ops-status-item" style="border-right:none;">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>
    <div>
      <div class="ops-status-label">Digital Signatures</div>
      <div class="ops-status-value">SHA-256 Verified</div>
    </div>
  </div>
</div>

<!-- MAIN GRID: TEMPLATES + CONTRACTOR LEAGUE -->
<div style="display:grid;grid-template-columns:1fr 340px;gap:20px;margin-bottom:20px;">
  
  <!-- LEFT: REPORT TEMPLATES -->
  <div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <h2 style="font-size:13px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin:0;">
        Certified Report Templates
      </h2>
      <div style="display:flex;gap:6px;">
        <button class="filter-tab active" data-cat="all">All</button>
        <button class="filter-tab" data-cat="Regulatory">Regulatory</button>
        <button class="filter-tab" data-cat="Operational">Operational</button>
        <button class="filter-tab" data-cat="Forensics">Forensics</button>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;" id="reports-grid">
      {reportTemplates.map(r => (
        <div class="card report-card" data-cat={r.category} style="padding:16px;display:flex;flex-direction:column;justify-content:space-between;transition:all 0.2s;">
          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
              <span class={`badge ${r.badgeClass}`} style="font-family:var(--font-mono);font-size:10px;">
                {r.type}
              </span>
              <span style="font-size:11px;color:var(--color-text-tertiary);">{r.size} • {r.records} records</span>
            </div>

            <h3 style="font-size:13px;font-weight:700;color:var(--color-text-primary);margin:0 0 6px 0;">
              {r.title}
            </h3>
            <p style="font-size:11px;color:var(--color-text-secondary);line-height:1.4;margin:0 0 12px 0;">
              {r.subtitle}
            </p>
          </div>

          <div>
            <div style="display:flex;align-items:center;justify-content:space-between;font-size:10px;color:var(--color-text-tertiary);padding-top:10px;border-top:1px solid var(--color-border);margin-bottom:10px;">
              <span>Cadence: <strong>{r.frequency}</strong></span>
              <span>Updated: {r.lastGenerated}</span>
            </div>

            <div style="display:flex;gap:8px;">
              <button class="btn btn-secondary btn-sm btn-preview-report" data-id={r.id} data-title={r.title} style="flex:1;justify-content:center;font-size:11px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                Preview
              </button>
              <button class="btn btn-primary btn-sm btn-download-report" data-title={r.title} data-type={r.type} style="flex:1;justify-content:center;font-size:11px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Export {r.type}
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- RIGHT: SUBCONTRACTOR SAFETY LEAGUE & AUDIT SIGN-OFF -->
  <div style="display:flex;flex-direction:column;gap:16px;">
    
    <!-- Subcontractor League Card -->
    <div class="card" style="padding:16px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <h3 style="font-size:12px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin:0;">
          Subcontractor Compliance
        </h3>
        <span class="badge badge-safe" style="font-size:9px;">Week 39</span>
      </div>

      <div style="display:flex;flex-direction:column;gap:10px;">
        {subcontractorScores.map(sub => (
          <div style="padding:10px;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:rgba(255,255,255,0.01);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
              <span style="font-size:12px;font-weight:600;color:var(--color-text-primary);">{sub.name}</span>
              <span style={`font-family:var(--font-mono);font-size:12px;font-weight:700;color:${sub.score>95 ? 'var(--color-safe)' : sub.score>85 ? 'var(--color-warning)' : 'var(--color-critical)'};`}>
                {sub.score}%
              </span>
            </div>
            <div style="width:100%;height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden;margin-bottom:6px;">
              <div style={`height:100%;width:${sub.score}%;background:${sub.score>95 ? 'var(--color-safe)' : sub.score>85 ? 'var(--color-warning)' : 'var(--color-critical)'};`}></div>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--color-text-tertiary);">
              <span>{sub.workers} deployed personnel</span>
              <span style={`color:${sub.violations > 5 ? 'var(--color-critical)' : 'inherit'};`}>
                {sub.violations} {sub.violations === 1 ? 'violation' : 'violations'}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Official OSHA Stamp Card -->
    <div class="card" style="padding:16px;background:linear-gradient(145deg, rgba(17,24,39,0.9), rgba(15,23,42,0.95));border:1px solid rgba(16,185,129,0.3);">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-safe)" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span style="font-size:12px;font-weight:700;color:var(--color-safe);text-transform:uppercase;letter-spacing:0.06em;">
          Certified OSHA Audit Trail
        </span>
      </div>
      <p style="font-size:11px;color:var(--color-text-secondary);line-height:1.4;margin:0 0 12px 0;">
        All exported dossiers are cryptographically signed with site HMAC credentials and comply with 29 CFR 1926 evidentiary admissibility rules.
      </p>
      <div style="font-family:var(--font-mono);font-size:9px;color:var(--color-text-tertiary);word-break:break-all;background:rgba(0,0,0,0.3);padding:6px;border-radius:3px;margin-bottom:12px;">
        HASH: 8f9b4a2c1e7d039f6a14b5c89e21
      </div>
      <button class="btn btn-ghost btn-sm" id="btn-verify-hash" style="width:100%;justify-content:center;font-size:11px;">
        Verify Audit Signature
      </button>
    </div>

  </div>
</div>

<!-- MODAL: CUSTOM REPORT GENERATOR -->
<div id="modal-gen-report" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(6,10,18,0.85);backdrop-filter:blur(6px);z-index:9999;align-items:center;justify-content:center;">
  <div class="card" style="width:100%;max-width:540px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-xl);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
      <div>
        <h2 style="font-size:16px;font-weight:700;color:var(--color-text-primary);margin:0;">Generate Custom Safety Dossier</h2>
        <p style="font-size:11px;color:var(--color-text-tertiary);margin:2px 0 0 0;">Define time bounds, target sectors, and telemetry inclusions</p>
      </div>
      <button class="btn btn-ghost btn-sm" id="btn-close-gen">✕</button>
    </div>

    <form id="form-custom-report" style="display:flex;flex-direction:column;gap:14px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Date Range</label>
          <select class="input">
            <option>Today (Shift 01 & 02)</option>
            <option>Past 24 Hours</option>
            <option>Past 7 Days (Standard Week)</option>
            <option>Month-to-Date (September 2026)</option>
            <option>Custom Date Window</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Target Sector Scope</label>
          <select class="input">
            <option>Entire Site (All Sectors A–E)</option>
            <option>Sector A — North Tower</option>
            <option>Sector B — Crane Staging</option>
            <option>Sector C — South Tower</option>
            <option>Sector D — Heavy Loading Bay</option>
          </select>
        </div>
      </div>

      <div>
        <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:6px;">Violation Types to Include</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:11px;">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" checked /> No Hard Hat / Helmet
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" checked /> No High-Vis Vest
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" checked /> Geofence / Crane Zone Breach
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" checked /> Proximity Near-Misses
          </label>
        </div>
      </div>

      <div>
        <label style="display:block;font-size:11px;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px;">Export Format</label>
        <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:8px;">
          <label class="card" style="padding:10px;text-align:center;cursor:pointer;background:rgba(37,99,235,0.1);border-color:var(--color-primary);">
            <input type="radio" name="format" value="pdf" checked style="margin-bottom:4px;" />
            <div style="font-weight:700;font-size:12px;">PDF</div>
            <div style="font-size:9px;color:var(--color-text-tertiary);">Executive</div>
          </label>
          <label class="card" style="padding:10px;text-align:center;cursor:pointer;">
            <input type="radio" name="format" value="csv" style="margin-bottom:4px;" />
            <div style="font-weight:700;font-size:12px;">CSV</div>
            <div style="font-size:9px;color:var(--color-text-tertiary);">Spreadsheet</div>
          </label>
          <label class="card" style="padding:10px;text-align:center;cursor:pointer;">
            <input type="radio" name="format" value="zip" style="margin-bottom:4px;" />
            <div style="font-weight:700;font-size:12px;">ZIP</div>
            <div style="font-size:9px;color:var(--color-text-tertiary);">CCTV Clips</div>
          </label>
          <label class="card" style="padding:10px;text-align:center;cursor:pointer;">
            <input type="radio" name="format" value="json" style="margin-bottom:4px;" />
            <div style="font-weight:700;font-size:12px;">JSON</div>
            <div style="font-size:9px;color:var(--color-text-tertiary);">Raw API</div>
          </label>
        </div>
      </div>

      <div style="background:rgba(255,255,255,0.02);padding:10px;border-radius:var(--radius-sm);border:1px solid var(--color-border);">
        <label style="display:flex;align-items:center;gap:8px;font-size:11px;cursor:pointer;">
          <input type="checkbox" checked /> Include High-Resolution Video Snapshot Evidences
        </label>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:10px;padding-top:14px;border-top:1px solid var(--color-border);">
        <button type="button" class="btn btn-ghost" id="btn-cancel-gen">Cancel</button>
        <button type="submit" class="btn btn-primary">Compile & Generate Dossier</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: LIVE REPORT PREVIEW -->
<div id="modal-preview" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(6,10,18,0.9);backdrop-filter:blur(8px);z-index:9999;align-items:center;justify-content:center;padding:20px;">
  <div class="card" style="width:100%;max-width:760px;max-height:90vh;overflow-y:auto;background:#0d1527;border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:28px;box-shadow:var(--shadow-xl);">
    
    <!-- Document Header -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;border-bottom:2px solid var(--color-primary);padding-bottom:16px;margin-bottom:20px;">
      <div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="font-family:var(--font-mono);font-size:18px;font-weight:800;color:var(--color-primary);letter-spacing:-0.03em;">SITESAGE</span>
          <span class="badge badge-safe" style="font-size:9px;">OFFICIAL OSHA DOSSIER</span>
        </div>
        <h2 style="font-size:17px;font-weight:700;color:#fff;margin:8px 0 2px 0;" id="preview-report-title">Daily Shift Safety & Near-Miss Briefing</h2>
        <div style="font-size:11px;color:var(--color-text-tertiary);">North Tower High-Rise Project • Sector Grid A through E</div>
      </div>
      <div style="text-align:right;">
        <button class="btn btn-ghost btn-sm" id="btn-close-preview" style="margin-bottom:8px;">✕ Close</button>
        <div style="font-family:var(--font-mono);font-size:10px;color:var(--color-text-secondary);">DOC ID: SS-2026-0929-881</div>
        <div style="font-family:var(--font-mono);font-size:10px;color:var(--color-text-tertiary);">TIMESTAMP: 2026-09-29 14:02:18 UTC</div>
      </div>
    </div>

    <!-- Executive Summary Box -->
    <div style="background:rgba(255,255,255,0.02);border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:14px;margin-bottom:20px;">
      <h4 style="font-size:11px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;margin:0 0 6px 0;">Executive Summary</h4>
      <p style="font-size:12px;color:var(--color-text-secondary);line-height:1.5;margin:0;">
        During Shift 01 (06:00 – 14:00), computer vision ingestion analyzed <strong>842,000 video frames</strong> across 27 edge camera nodes. 
        A total of <strong>4 safety infractions</strong> were flagged in real time, with an overall site PPE compliance metric of <strong>96.4%</strong>. 
        Zero lost-time injuries occurred.
      </p>
    </div>

    <!-- Preview Incident Evidence Image -->
    <div style="margin-bottom:20px;">
      <h4 style="font-size:11px;font-weight:700;color:var(--color-text-secondary);text-transform:uppercase;margin:0 0 8px 0;">Sample Forensic Evidence Snapshot</h4>
      <div style="background:#060a12;border:1px solid var(--color-border);border-radius:var(--radius-sm);aspect-ratio:16/7;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;">
        <svg viewBox="0 0 600 250" style="position:absolute;inset:0;width:100%;height:100%;">
          <rect width="600" height="250" fill="#090f1d"/>
          <!-- Grid lines -->
          <line x1="50" y1="200" x2="550" y2="200" stroke="#1f293d" stroke-width="2"/>
          <line x1="150" y1="50" x2="150" y2="200" stroke="#1f293d" stroke-width="3"/>
          <line x1="450" y1="80" x2="450" y2="200" stroke="#1f293d" stroke-width="3"/>
          <!-- Bounding box -->
          <rect x="240" y="80" width="80" height="110" fill="none" stroke="#EF4444" stroke-width="2"/>
          <rect x="240" y="62" width="130" height="18" fill="#EF4444"/>
          <text x="245" y="75" fill="#FFFFFF" font-size="10" font-family="monospace" font-weight="bold">NO HARD HAT [91%]</text>
          <text x="245" y="100" fill="#EF4444" font-size="9" font-family="monospace">CAM-04 CRANE ZONE</text>
        </svg>
        <div style="position:absolute;bottom:8px;left:8px;font-family:var(--font-mono);font-size:9px;color:rgba(255,255,255,0.7);background:rgba(0,0,0,0.7);padding:2px 6px;border-radius:2px;">
          INCIDENT REF: INC-0248 • RECORDED: 13:42:09 UTC
        </div>
      </div>
    </div>

    <!-- Sign-off Block -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid var(--color-border);padding-top:16px;">
      <div>
        <div style="font-size:10px;color:var(--color-text-tertiary);text-transform:uppercase;">Site Safety Officer Sign-Off</div>
        <div style="font-family:monospace;font-size:12px;color:var(--color-safe);margin-top:6px;">✓ DIGITALLY SIGNED: S. Chen, CSP</div>
        <div style="font-size:10px;color:var(--color-text-tertiary);">Badge ID: SS-SAFETY-994</div>
      </div>
      <div style="text-align:right;">
        <button class="btn btn-primary btn-sm" id="btn-print-dossier">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
          </svg>
          Print / Save PDF
        </button>
      </div>
    </div>

  </div>
</div>

<style>
.filter-tab {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 11px;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.15s ease;
}
.filter-tab:hover {
  background: rgba(255,255,255,0.04);
  color: var(--color-text-primary);
}
.filter-tab.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}
.report-card:hover {
  border-color: var(--color-border-focus);
  transform: translateY(-1px);
}
</style>

<script>
  // Filter tabs for reports
  const filterTabs = document.querySelectorAll('.filter-tab');
  const reportCards = document.querySelectorAll<HTMLElement>('.report-card');

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const cat = tab.getAttribute('data-cat') || 'all';

      reportCards.forEach(card => {
        const cardCat = card.getAttribute('data-cat');
        card.style.display = (cat === 'all' || cardCat === cat) ? 'flex' : 'none';
      });
    });
  });

  // Modal Custom Report Generator
  const btnCustomReport = document.getElementById('btn-custom-report');
  const modalGenReport = document.getElementById('modal-gen-report');
  const btnCloseGen = document.getElementById('btn-close-gen');
  const btnCancelGen = document.getElementById('btn-cancel-gen');
  const formCustomReport = document.getElementById('form-custom-report');

  btnCustomReport?.addEventListener('click', () => {
    if (modalGenReport) modalGenReport.style.display = 'flex';
  });

  const hideGenModal = () => {
    if (modalGenReport) modalGenReport.style.display = 'none';
  };

  btnCloseGen?.addEventListener('click', hideGenModal);
  btnCancelGen?.addEventListener('click', hideGenModal);
  formCustomReport?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Report generation initiated! Your compiled OSHA dossier is downloading.');
    hideGenModal();
  });

  // Preview Modal
  const modalPreview = document.getElementById('modal-preview');
  const btnClosePreview = document.getElementById('btn-close-preview');
  const previewTitle = document.getElementById('preview-report-title');
  const previewBtns = document.querySelectorAll('.btn-preview-report');

  previewBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title') || 'Official Report';
      if (previewTitle) previewTitle.textContent = title;
      if (modalPreview) modalPreview.style.display = 'flex';
    });
  });

  btnClosePreview?.addEventListener('click', () => {
    if (modalPreview) modalPreview.style.display = 'none';
  });

  // Download export alerts
  document.querySelectorAll('.btn-download-report').forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title');
      const type = btn.getAttribute('data-type');
      alert(`Downloading ${type} package: "${title}" (SHA-256 verified)`);
    });
  });

  document.getElementById('btn-schedule-export')?.addEventListener('click', () => {
    alert('Scheduled Exports Config:\n• Daily 18:00 UTC -> EHS Directors\n• Weekly Friday 22:00 -> OSHA Compliance Officer\n• Critical Geofence Breaches -> Immediate Dispatch to Webhook');
  });

  document.getElementById('btn-verify-hash')?.addEventListener('click', () => {
    alert('Audit Signature Verified: HMAC-SHA256 valid. Key: SITESAGE-NORTH-TOWER-PROD.');
  });

  document.getElementById('btn-print-dossier')?.addEventListener('click', () => {
    window.print();
  });
</script>

</Layout>
